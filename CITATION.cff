    affiliation: 3D Geodata Academy
    website: "https://learngeodata.eu"
repository-code: "https://github.com/florentPoux/3d-data-materials"
url: "https://learngeodata.eu/materials/"
license: MIT
keywords:
  - 3D point cloud processing
  - Spatial AI
  - LiDAR
  - Photogrammetry
  - 3D deep learning
  - Geospatial data science
  - Gaussian splatting
  - Python
